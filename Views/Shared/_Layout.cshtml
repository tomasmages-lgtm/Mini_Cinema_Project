<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini_Cinema</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Mini_Cinema.styles.css" asp-append-version="true" />
    <link rel="icon" href="~/cinema.webp"></link>
</head>

<body>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Limelight&family=DM+Sans:wght@500;600&display=swap" rel="stylesheet">
    <link href="~/css/home/index.css" rel="stylesheet"></link>
    <header class="site-header">
        <div class="site-header__inner">

            <a class="logo" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Lumière home">
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M6 12h36v8a4 4 0 0 0 0 8v8H6v-8a4 4 0 0 0 0-8z"
                        stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                    <path d="M20 17.5v13l11-6.5z" fill="currentColor" />
                </svg>
                <span class="logo__text">Lumière</span>
            </a>

            <nav class="nav" aria-label="Main">
                <a asp-area="Customer" asp-controller="Home" asp-action="Index">Movies</a>
               <a class="nav__cta" asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a>
            </nav>

        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
