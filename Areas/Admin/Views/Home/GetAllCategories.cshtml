@model IEnumerable<Category>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Latest movies</title>
    <link href="~/css/admin/form/index.css" rel="stylesheet" />
</head>
<body>
    <div class="panel">
        <h2>Latest Categories</h2>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Name</th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.Name</td>
                            <td><div class="actions"><a href="/Admin/Category/Update?Id=@c.Id" class="btn edit" title="Edit" aria-label="Edit">✎ Edit</a><a href="/Admin/Category/Delete?Id=@c.Id" class="btn del" title="Delete" aria-label="Delete">🗑 Delete</a></div></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>