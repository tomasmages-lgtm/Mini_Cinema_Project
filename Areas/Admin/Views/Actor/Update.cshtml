@model Actor
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Add Actor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-black text-white">

    <div class="container py-5">
        <h2 class="mb-4">Add Actor</h2>

        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label for="FName" class="form-label">FName</label>
                <input type="text" id="FName" name="FName" value="@Model.FName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="LName" class="form-label">LName</label>
                <input type="text" id="LName" name="LName" value="@Model.LName" class="form-control" required />
            </div>

            <div class="mb-3">
                <label for="imgFile" class="form-label">Main image</label>
                <input type="file" id="imgFile" name="ActualFile" class="form-control" accept="image/*" />
                 
                <img id="imgPreview"
                    src="~/Mini _Cinema_Img/Actors_Images/@Model.Img"
                    alt="Preview"
                    class="img-thumbnail mt-2"
                    style="max-width:200px;" />
            </div>

            <button type="submit" class="btn btn-warning px-4">Save</button>
            <a href="/Admin" class="btn btn-outline-light ms-2">Cancel</a>
        </form>
    </div>

</body>
</html>
<script>
    const imgFile = document.getElementById("imgFile");
    const imgPreview = document.getElementById("imgPreview");
    const originalSrc = imgPreview.getAttribute("src");

    imgFile.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
            imgPreview.src = URL.createObjectURL(file);
            imgPreview.style.display = "block";
        } else {
            imgPreview.src = originalSrc; 
        }
    });
</script>