@model Actor
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Add Actor</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-black text-white">

    <div class="container py-5">
        <h2 class="mb-4">Add Actor</h2>

        <form method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label asp-for="FName" class="form-label"></label>
                <input asp-for="FName" class="form-control" />
                <span asp-validation-for="FName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LName" class="form-label"></label>
                <input asp-for="LName" class="form-control" />
                <span asp-validation-for="LName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="imgFile" class="form-label">Main image</label>
                <input type="file" id="imgFile" name="ActualFile" class="form-control" accept="image/*" />

                <img id="imgPreview" alt="Preview" class="img-thumbnail mt-2"
                     style="max-width:200px; display:none;" />
            </div>

            <button type="submit" class="btn btn-warning px-4">Save</button>
            <a href="/Admin" class="btn btn-outline-light ms-2">Cancel</a>
        </form>
    </div>

</body>
</html>

<script>
    document.getElementById("imgFile").addEventListener("change", function () {
        const file = this.files[0];
        const preview = document.getElementById("imgPreview");

        if (file) {
            preview.src = URL.createObjectURL(file);
            preview.style.display = "block";
        } else {
            preview.style.display = "none";
        }
    });
</script>